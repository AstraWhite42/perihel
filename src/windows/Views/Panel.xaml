<Window x:Class="Perihel.Panel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="近星点">
  <Grid x:Name="Root" Padding="16" RowSpacing="12" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource PanelOutline}" UseLayoutRounding="True" Language="zh-CN">
    <Grid.Resources><Style x:Key="AcrylicSurface" TargetType="Grid"><Setter Property="Background" Value="Transparent"/></Style><Style x:Key="SolidSurface" TargetType="Grid"><Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}"/></Style></Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="Toolbar" ColumnSpacing="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="32" Height="32" CornerRadius="9" Background="{ThemeResource AccentFillColorDefaultBrush}">
        <Image x:Name="EnergyPreview" Width="25" Height="25"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="5,0,0,0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="近星点" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock x:Name="TrayValue" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,5,0">
        <ProgressRing x:Name="StatusSpinner" Width="12" Height="12" MinWidth="0" MinHeight="0" IsActive="False" Visibility="Collapsed"/>
        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{ThemeResource SystemFillColorSuccessBrush}"/>
        <TextBlock x:Name="Status" Style="{StaticResource Meta}"/>
      </StackPanel>
      <Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource ToolButton}" Click="RefreshClick" AutomationProperties.Name="刷新" ToolTipService.ToolTip="刷新"><FontIcon Glyph="&#xE72C;" FontSize="15"/></Button>
      <Button Grid.Column="4" Style="{StaticResource ToolButton}" AutomationProperties.Name="额度说明" ToolTipService.ToolTip="额度说明"><FontIcon Glyph="&#xE946;" FontSize="15"/>
        <Button.Flyout><Flyout><StackPanel MaxWidth="280" Spacing="8">
          <TextBlock Text="额度说明" Style="{ThemeResource SubtitleTextBlockStyle}"/>
          <TextBlock Text="理论用量" FontWeight="SemiBold"/><TextBlock Text="按当前时间在额度窗口中的进度，计算匀速消耗时的理论已用和剩余百分比。" TextWrapping="Wrap"/>
          <TextBlock Text="窗口时间" FontWeight="SemiBold"/><TextBlock Text="开始时间由重置时刻减去窗口长度推算。所有日期使用系统时区。" TextWrapping="Wrap"/>
          <TextBlock Text="重置机会" FontWeight="SemiBold"/><TextBlock Text="可用次数以服务端返回值为准。到期明细可能不完整。" TextWrapping="Wrap"/>
          <TextBlock x:Name="InfoVersion" Style="{ThemeResource CaptionTextBlockStyle}"/>
        </StackPanel></Flyout></Button.Flyout>
      </Button>
      <Button Grid.Column="5" Style="{StaticResource ToolButton}" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置"><FontIcon Glyph="&#xE713;" FontSize="15"/>
        <Button.Flyout><MenuFlyout x:Name="SettingsMenu"><MenuFlyoutSubItem x:Name="ThemeMenu" Text="主题"/><MenuFlyoutSubItem x:Name="DirectionMenu" Text="能量格熄灭方向"/><MenuFlyoutSubItem x:Name="DisplayMenu" Text="托盘显示"/><MenuFlyoutSubItem x:Name="SegmentsMenu" Text="进度条分段"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="连接与登录引导" Click="SetupClick"/><MenuFlyoutItem x:Name="PickMenu" Text="选择已有 CLI…" Click="PickClick"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="退出近星点" Click="ExitClick"/></MenuFlyout></Button.Flyout>
      </Button>
    </Grid>
    <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
      <StackPanel x:Name="Body" VerticalAlignment="Top" Spacing="10">
        <InfoBar x:Name="Notice" IsClosable="False" Severity="Warning"/>
        <StackPanel x:Name="Guide" Spacing="12">
          <TextBlock Text="连接 Codex CLI" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="使用本机 CLI 读取你的 ChatGPT 订阅额度。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
          <Border Style="{StaticResource GuideCard}"><StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE756;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="检测 CLI" FontWeight="SemiBold"/></StackPanel>
            <TextBlock x:Name="CliInfo" IsTextSelectionEnabled="True" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="选择 CLI…" Click="PickClick" x:Name="PickButton"/><HyperlinkButton Content="安装说明" NavigateUri="https://developers.openai.com/codex/windows/"/></StackPanel>
          </StackPanel></Border>
          <Border Style="{StaticResource GuideCard}"><StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="登录 ChatGPT 账户" FontWeight="SemiBold"/></StackPanel>
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="5" Padding="9,5"><TextBlock Text="codex login" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsTextSelectionEnabled="True"/></Border>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="打开终端登录" x:Name="LoginButton" Click="LoginClick"/><Button Content="复制命令" Click="CopyClick"/></StackPanel>
          </StackPanel></Border>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="StartButton" Content="开始使用" Padding="20,6" Style="{ThemeResource AccentButtonStyle}" Click="StartClick"/><Button x:Name="RetryButton" Content="重新检测" Click="RefreshClick"/></StackPanel>
        </StackPanel>
        <StackPanel x:Name="Cards" Spacing="10"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
