<UserControl x:Class="Perihel.QuotaCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="TrackStyle" TargetType="Grid"><Setter Property="Background" Value="{ThemeResource TrackBrush}"/></Style>
    <Style x:Key="ActualStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/></Style>
  </UserControl.Resources>
  <Border Style="{StaticResource GuideCard}">
    <StackPanel Spacing="5">
      <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock x:Name="AccountLabel" Grid.Column="1" Style="{StaticResource Meta}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="Zone" Grid.Column="2" Style="{StaticResource Meta}" FontSize="12" VerticalAlignment="Center"/>
      </Grid>
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="剩余额度" Style="{StaticResource Meta}"/>
          <StackPanel Orientation="Horizontal" Spacing="2">
            <TextBlock x:Name="Remaining" FontFamily="Segoe UI" FontSize="38" FontWeight="SemiBold" CharacterSpacing="-10" Typography.NumeralAlignment="Tabular"/>
            <TextBlock x:Name="PercentSign" Text="%" FontSize="19" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
          <TextBlock Text="距离重置" HorizontalAlignment="Right" Style="{StaticResource Meta}"/>
          <TextBlock x:Name="Countdown" HorizontalAlignment="Right" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
        </StackPanel>
      </Grid>
      <Grid><TextBlock x:Name="StartTime" Style="{StaticResource Meta}"/><TextBlock x:Name="EndTime" HorizontalAlignment="Right" Style="{StaticResource Meta}"/></Grid>
      <StackPanel Spacing="2"><Grid x:Name="Timeline" Height="16" SizeChanged="ResizeBar">
        <Grid x:Name="Track" CornerRadius="4" Height="8" VerticalAlignment="Center"/>
        <Rectangle x:Name="Marker" Width="2" Height="16" RadiusX="1" RadiusY="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorPrimaryBrush}"><Rectangle.RenderTransform><TranslateTransform x:Name="Offset"/></Rectangle.RenderTransform></Rectangle>
        <Canvas x:Name="ExpiryMarks" Height="16" VerticalAlignment="Center"/>
        <Path x:Name="Flag" Visibility="Collapsed" AutomationProperties.Name="预告时点" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M 1,15 L 1,1 L 10,1 L 7,4 L 10,7 L 2,7 L 2,15 Z" Fill="{ThemeResource ForecastInk}"><Path.RenderTransform><TranslateTransform x:Name="FlagOffset"/></Path.RenderTransform></Path>
      </Grid>
      <Canvas x:Name="SegmentLabels" Height="16" Visibility="Collapsed"/></StackPanel>
      <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
          <TextBlock Text="已用" Style="{StaticResource Meta}"/>
          <Rectangle Width="2" Height="10" Margin="5,0,0,0" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
          <TextBlock Text="理论" Style="{StaticResource Meta}"/>
          <StackPanel x:Name="ExpiryLegend" Orientation="Horizontal" Spacing="4" Margin="5,0,0,0">
            <Path Data="M 0,4 L 4,0 L 8,4 L 4,8 Z" Fill="#E78728" VerticalAlignment="Center"/>
            <TextBlock Text="到期" Style="{StaticResource Meta}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="Budget" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <Button x:Name="BudgetToggle" Click="ToggleBudget" Padding="5,2" MinHeight="24" Style="{ThemeResource SubtleButtonStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
            <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock x:Name="BudgetLabel" FontSize="12" FontWeight="SemiBold"/><FontIcon x:Name="BudgetChevron" FontSize="9"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <Border x:Name="NewsBox" Visibility="Collapsed" Background="{ThemeResource ForecastSurface}" Padding="10" CornerRadius="8">
        <StackPanel Spacing="4">
          <Grid><TextBlock x:Name="NewsTitle" Foreground="{ThemeResource ForecastInk}" FontWeight="SemiBold" FontSize="13"/>
            <HyperlinkButton x:Name="SourceLink" Content="来源 ↗" HorizontalAlignment="Right" Padding="2,0" MinHeight="18" FontSize="12"/></Grid>
          <TextBlock x:Name="NewsTime" Foreground="{ThemeResource ForecastInk}" TextWrapping="Wrap" FontSize="12"/>
          <TextBlock x:Name="NewsText" IsTextTrimmedChanged="NewsTrimChanged" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" FontSize="12"/>
          <Grid><Button x:Name="OriginalToggle" Content="展开原文" Click="ToggleOriginal" Style="{ThemeResource SubtleButtonStyle}" Padding="2,0" MinHeight="20" FontSize="12"/>
            <HyperlinkButton Content="数据：Codex Resets ↗" NavigateUri="https://codex-resets.com" HorizontalAlignment="Right" Padding="2,0" MinHeight="20" FontSize="12"/></Grid>
          <TextBlock x:Name="Published" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBlock x:Name="Delayed" Text="消息更新延迟，暂不作为用量目标。" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <StackPanel x:Name="Details" Visibility="Collapsed" Spacing="4" BorderBrush="{ThemeResource CardOutline}" BorderThickness="0,1,0,0" Padding="0,8,0,0"/>
    </StackPanel>
  </Border>
</UserControl>
