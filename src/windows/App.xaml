<Application x:Class="Perihel.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PanelSurface" Color="#EDF2F6"/>
          <SolidColorBrush x:Key="PanelWash" Color="#DDEDF2F6"/>
          <SolidColorBrush x:Key="CardSurface" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="CardOutline" Color="#D7E0E8"/>
          <SolidColorBrush x:Key="PanelOutline" Color="#A8B6C5"/>
          <SolidColorBrush x:Key="TrackBrush" Color="#DDE6EF"/>
          <SolidColorBrush x:Key="ForecastInk" Color="#67409F"/>
          <SolidColorBrush x:Key="ForecastSurface" Color="#F4EFFA"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="PanelSurface" Color="#1B2129"/>
          <SolidColorBrush x:Key="PanelWash" Color="#DC1B2129"/>
          <SolidColorBrush x:Key="CardSurface" Color="#252D37"/>
          <SolidColorBrush x:Key="CardOutline" Color="#3B4653"/>
          <SolidColorBrush x:Key="PanelOutline" Color="#647487"/>
          <SolidColorBrush x:Key="TrackBrush" Color="#42505E"/>
          <SolidColorBrush x:Key="ForecastInk" Color="#D9BEFF"/>
          <SolidColorBrush x:Key="ForecastSurface" Color="#372F47"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="PanelSurface" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="PanelWash" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="CardSurface" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="CardOutline" Color="{ThemeResource SystemColorWindowTextColor}"/>
          <SolidColorBrush x:Key="PanelOutline" Color="{ThemeResource SystemColorWindowTextColor}"/>
          <SolidColorBrush x:Key="TrackBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
          <SolidColorBrush x:Key="ForecastInk" Color="{ThemeResource SystemColorWindowTextColor}"/>
          <SolidColorBrush x:Key="ForecastSurface" Color="{ThemeResource SystemColorWindowColor}"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI, Segoe UI</FontFamily>
      <Style x:Key="GuideCard" TargetType="Border">
        <Setter Property="Padding" Value="15,12"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{ThemeResource CardSurface}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardOutline}"/>
        <Setter Property="BorderThickness" Value="1"/>
      </Style>
      <Style x:Key="Meta" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
      </Style>
      <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="6"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
